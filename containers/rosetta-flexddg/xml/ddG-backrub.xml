<ROSETTASCRIPTS>
    <!--
    Flex-ddG protocol: backrub conformational sampling + DDG calculation.
    Based on the Kortemme Lab flex-ddG tutorial.

    Script variables (set via -parser:script_vars):
      - number_backrub_trials: backrub sampling intensity (default 35000)
      - max_minimization_iter: gradient descent steps (default 5000)
      - chainstomove: chain(s) to dissociate for DDG (e.g., "B")
    -->

    <SCOREFXNS>
        <ScoreFunction name="ref2015_soft" weights="ref2015_soft"/>
        <ScoreFunction name="ref2015" weights="ref2015"/>
    </SCOREFXNS>

    <RESIDUE_SELECTORS>
        <Chain name="chaintomove" chains="%%chainstomove%%"/>
        <Not name="chaintofix" selector="chaintomove"/>
    </RESIDUE_SELECTORS>

    <TASKOPERATIONS>
        <InitializeFromCommandline name="init"/>
        <RestrictToRepacking name="repack_only"/>
    </TASKOPERATIONS>

    <MOVERS>
        <Backrub name="backrub"/>

        <MinMover name="min_sc" scorefxn="ref2015" type="lbfgs_armijo_nonmonotone"
                  tolerance="0.01" max_iter="%%max_minimization_iter%%" chi="true" bb="false"/>

        <MinMover name="min_all" scorefxn="ref2015" type="lbfgs_armijo_nonmonotone"
                  tolerance="0.01" max_iter="%%max_minimization_iter%%" chi="true" bb="true"/>

        <PackRotamersMover name="repack" scorefxn="ref2015" task_operations="init,repack_only"/>

        <GenericMonteCarlo name="backrub_mc" mover_name="backrub"
                           scorefxn_name="ref2015_soft" trials="%%number_backrub_trials%%"
                           temperature="1.2" recover_low="true"/>
    </MOVERS>

    <PROTOCOLS>
        <!-- Phase 1: Backrub conformational sampling -->
        <Add mover="backrub_mc"/>
        <!-- Phase 2: Minimize wild-type -->
        <Add mover="repack"/>
        <Add mover="min_sc"/>
        <Add mover="min_all"/>
    </PROTOCOLS>
</ROSETTASCRIPTS>
